# QualityLens Environment Configuration Template

# Server Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL / SQLite fallback for development)
DATABASE_URL=sqlite:///./qualitylens.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qualitylens

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=quality-lens-c174e
# Path to service account json file if downloaded, or left empty for emulation/dev mode:
FIREBASE_CREDENTIALS_PATH=
# Whether to bypass token verification for local offline development/testing
DEV_AUTH_BYPASS=True

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=dlvjvskje
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=Quality lens

# Quality Threshold Defaults (Demonstration defaults)
THRESHOLD_NORMAL_MAX=2.0
THRESHOLD_WARNING_MAX=5.0
